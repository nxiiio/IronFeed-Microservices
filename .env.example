# Shared by users-ms and api-gateway.
# Use the same value in both services and keep the real value only in .env.
# Minimum length: 32 characters.
JWT_SECRET=change-me-with-at-least-32-characters

# AWS Academy deployment examples.
# Private backend EC2: used by docker-compose.aws-backend.yml.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-for-aws
API_GATEWAY_BIND_ADDRESS=0.0.0.0

# Public frontend EC2: used by docker-compose.aws-public.yml.
API_GATEWAY_UPSTREAM=http://PRIVATE_BACKEND_IP:8080
